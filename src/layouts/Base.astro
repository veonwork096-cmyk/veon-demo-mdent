---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/ui.css";
import logo from "../assets/logo-mdent.svg";
import geologica from "../assets/fonts/geologica-cyrillic-wght-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#552580" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <link rel="icon" href={logo.src} type="image/svg+xml" />
    <link rel="preload" href={geologica} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>
      /* Floor 34 next to <html>: the linter does not follow frontmatter CSS imports */
      html { overflow-x: clip; }
      body { overflow-x: clip; }
    </style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
