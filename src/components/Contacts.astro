---
import Section from "./Section.astro";
import { cities, telegram, socials } from "../data/site";
const open = cities.flatMap((g) => g.clinics).filter((c) => !c.soon);
---
<Section id="contacts" rec="R-004,S-R009" class="contacts">
  <div class="container contacts__grid">
    <div class="contacts__head">
      <h2>Контакти клінік</h2>
      <p class="muted">Телефонуйте в найближчу клініку або напишіть нам.</p>
      <a class="btn btn--outline contacts__tg" href={telegram} target="_blank" rel="noopener">Написати в Telegram</a>
      <ul class="contacts__social" aria-label="MDENT у соцмережах">
        {socials.map((s) => <li><a class="text-link" href={s.href} target="_blank" rel="noopener">{s.name}</a></li>)}
      </ul>
    </div>
    <ul class="book">
      {open.map((c) => (
        <li class="book__row">
          <p class="book__name">{c.city === "Кам'янське" ? `Кам'янське, ${c.name.startsWith('Orto') ? c.name : c.name.toLowerCase()}` : c.city}{c.note && <span class="muted">, {c.note}</span>}</p>
          <p class="book__addr muted">{c.address}</p>
          <p class="book__phones">
            {c.phones.map((p) => <a class="book__phone" href={`tel:${p.tel}`}>{p.label}</a>)}
          </p>
        </li>
      ))}
      <li class="book__row book__row--soon">
        <p class="book__name">Олександрія</p>
        <p class="book__addr muted">вул. Поштова, 53</p>
        <p class="book__phones muted">Незабаром відкриття</p>
      </li>
    </ul>
  </div>
</Section>

<style>
  :global(#contacts) { padding-block: var(--section-gap); }
  .contacts__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--gap-columns); align-items: start; }
  .contacts__head { display: grid; gap: var(--gap-md); justify-items: start; }
  .contacts__tg { margin-top: var(--gap-xs); }
  .contacts__social { display: flex; flex-wrap: wrap; gap: 0 var(--gap-lg); }

  .book { border-top: 1px solid var(--color-rule); }
  .book__row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 4fr); gap: var(--gap-md); align-items: center; padding-block: var(--gap-md); border-bottom: 1px solid var(--color-rule); }
  .book__name { font-weight: 600; }
  .book__phones { display: flex; flex-direction: column; align-items: flex-start; }
  .book__phone { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--color-field); white-space: nowrap; text-decoration: underline; text-decoration-color: var(--color-rule); text-decoration-thickness: 2px; text-underline-offset: 0.2em; transition: text-decoration-color var(--dur-short) var(--ease-out); }
  .book__phone:hover { text-decoration-color: var(--color-accent); }
  .book__phone:active { transform: translateY(1px); }

  @media (max-width: 63.99rem) {
    .contacts__grid { grid-template-columns: minmax(0, 1fr); gap: var(--gap-xl); }
  }
  @media (max-width: 47.99rem) {
    .book__row { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .contacts__tg { width: 100%; min-height: 56px; }
  }
</style>
